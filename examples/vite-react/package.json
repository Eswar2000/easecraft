{
  "name": "easecraft-vite-react-example",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer smoke-test application for Easecraft.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.json && vite build",
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
