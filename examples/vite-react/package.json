    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "easecraft-tokens": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "easecraft-eslint-config": "workspace:*",
    "easecraft-typescript-config": "workspace:*",
    "vite": "8.1.5"
  }
}
