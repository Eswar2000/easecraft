{
  "name": "easecraft-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible motion primitives and animated React components, powered by Anime.js.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter easecraft-tokens build && pnpm --filter easecraft build && turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "typescript": "6.0.3"
  }
}
