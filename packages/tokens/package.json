{
  "name": "easecraft-tokens",
  "version": "0.0.0",
  "description": "Framework-independent motion tokens for Easecraft.",
  "keywords": [
    "animation",
    "design-tokens",
    "easing",
    "motion",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://easecraft-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Eswar2000/easecraft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eswar2000/easecraft.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "easecraft-eslint-config": "workspace:*",
    "easecraft-typescript-config": "workspace:*",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
