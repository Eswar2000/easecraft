{
  "name": "easecraft-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Typed metadata and copyable component source for Easecraft.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "source"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compositions/command-palette": {
      "types": "./dist/compositions/command-palette.d.ts",
      "import": "./dist/compositions/command-palette.js",
      "default": "./dist/compositions/command-palette.js"
    },
    "./compositions/expandable-project-card": {
      "types": "./dist/compositions/expandable-project-card.d.ts",
      "import": "./dist/compositions/expandable-project-card.js",
      "default": "./dist/compositions/expandable-project-card.js"
    },
    "./compositions/filterable-work-gallery": {
      "types": "./dist/compositions/filterable-work-gallery.d.ts",
      "import": "./dist/compositions/filterable-work-gallery.js",
      "default": "./dist/compositions/filterable-work-gallery.js"
    },
    "./compositions/mobile-navigation-panel": {
      "types": "./dist/compositions/mobile-navigation-panel.d.ts",
      "import": "./dist/compositions/mobile-navigation-panel.js",
      "default": "./dist/compositions/mobile-navigation-panel.js"
    },
    "./compositions/notification-center": {
      "types": "./dist/compositions/notification-center.d.ts",
      "import": "./dist/compositions/notification-center.js",
      "default": "./dist/compositions/notification-center.js"
    },
    "./compositions/onboarding-progress-sequence": {
      "types": "./dist/compositions/onboarding-progress-sequence.d.ts",
      "import": "./dist/compositions/onboarding-progress-sequence.js",
      "default": "./dist/compositions/onboarding-progress-sequence.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-toast": "1.2.23",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "animejs": "4.5.0",
    "easecraft": "workspace:*",
    "easecraft-eslint-config": "workspace:*",
    "easecraft-tokens": "workspace:*",
    "easecraft-typescript-config": "workspace:*",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
