{
  "name": "easecraft-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation and interactive playground for Easecraft.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
