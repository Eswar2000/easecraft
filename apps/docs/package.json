    "easecraft-tokens": "workspace:*",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "easecraft-eslint-config": "workspace:*",
    "easecraft-typescript-config": "workspace:*",
    "jsdom": "29.1.1",
    "vitest": "4.1.10"
  }
